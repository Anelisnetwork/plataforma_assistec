# ErrorDocument 404 http://www.w210k.es/MC_nuevo/error_docs/404_NotFound.php

<IfModule mod_gzip.c>
mod_gzip_on Yes
mod_gzip_dechunk Yes
mod_gzip_item_include file .(html?|txt|css|js|php|pl)$
mod_gzip_item_include handler ^cgi-script$
mod_gzip_item_include mime ^text/.*
mod_gzip_item_include mime ^application/x-javascript.*
mod_gzip_item_exclude mime ^image/.*
mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</IfModule>

RewriteEngine On

#Rewritebase /proyectos/plataforma_assistec/
# QUITAR 

#RewriteRule ^(\w+)/$ /index.php?module=$1

#RewriteRule ^(\w+) /index.php

#RewriteCond %{REQUEST_URI} !^/plataforma/take_xml.php?$
#RewriteCond %{REQUEST_URI} !^/proceso_de_pago?$
#RewriteCond %{HTTPS} !=on
#RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


RewriteRule ^sl_access_assistec/$ /silent_log.php
RewriteRule ^silent_login/(.*)/$ /procesando.php?idproceso=silent_login&login=$1

RewriteRule ^api/(.*)/$ /api.php?metodo=$1

RewriteRule ^proceso_de_pago/$ /proceso_de_pago.php
RewriteRule ^proceso_de_pago/(\w+)/$ /proceso_de_pago.php?datos=$1

RewriteRule ^pago_realizado/(\w+)/$ /pago_realizado.php?datos=$1
RewriteRule ^error_pago/(\w+)/$ /error_pago.php?datos=$1

RewriteRule ^proceso_de_pago_test/assistech_test/$ /proceso_de_pago_test.php


#RewriteRule ^(\w+)/(\w+)/$ /index.php?module=$1&seccion=$2

RewriteRule ^genera_informe/(.*)/$ /core/includes/imagenes_informe.php?contenido=$1

RewriteRule ^pdf/(.*)/$ /scripts/imprimir_pdf.php?contenido=$1

RewriteRule pdf/$ /scripts/imprimir_pdf.php

RewriteRule base_ajax/$ /scripts/base_ajax.php
RewriteRule ^(.*)/base_ajax/$ /scripts/base_ajax.php

RewriteRule ^descarga_excel/([a-zA-Z0-9-._]+)/$ /scripts/descarga_excel.php?tipo_archivo=$1
RewriteRule ^descarga_excel/$ /scripts/descarga_excel.php

RewriteRule ^([a-zA-Z0-9-._]+)/$ /index.php?module=$1

RewriteRule ^([a-zA-Z0-9-._]+)/([a-zA-Z0-9-._]+)/$ /index.php?module=$1&seccion=$2

RewriteRule ^datos_del_mes/([0-9]+)/([0-9]+)/$ /index.php?module=datos_del_mes&mes=$1&anho=$2

RewriteRule ^informes_del_mes/([a-zA-Z0-9-._]+)/([0-9]+)/([0-9]+)/$ /index.php?module=informes_del_mes&seccion=$1&mes=$2&anho=$3

RewriteRule ^ratios_acumulados/([a-zA-Z0-9-._]+)/([0-9]+)/$ /index.php?module=ratios_acumulados&seccion=$1&anho=$2

RewriteRule ^km0/([a-zA-Z0-9-._]+)/([0-9]+)/([0-9]+)/$ /index.php?module=km0&seccion=$1&mes=$2&anho=$3

RewriteRule ^usuarios/([a-zA-Z0-9-._]+)/$ /index.php?module=usuarios&seccion=$1
RewriteRule ^usuarios/listado_usuarios/pagina/([0-9]+)/$ /index.php?module=usuarios&seccion=listado_usuarios&pagina=$1
RewriteRule ^usuarios/editar_usuario/([0-9]+)/$ /index.php?module=usuarios&seccion=editar_usuario&idusuario=$1
RewriteRule ^usuarios/estado/activos/$ /index.php?module=usuarios&seccion=listado_usuarios&usu_est=1
RewriteRule ^usuarios/estado/inactivos/$ /index.php?module=usuarios&seccion=listado_usuarios&usu_est=3
RewriteRule ^usuarios/estado/pendientes_de_datos/$ /index.php?module=usuarios&seccion=listado_usuarios&usu_est=2

RewriteRule ^talleres/([a-zA-Z0-9-._]+)/$ /index.php?module=talleres&seccion=$1
RewriteRule ^talleres/listado_talleres/pagina/([0-9]+)/$ /index.php?module=talleres&seccion=listado_talleres&pagina=$1
RewriteRule ^talleres/editar_taller/([0-9]+)/$ /index.php?module=talleres&seccion=editar_taller&idtaller=$1
RewriteRule ^talleres/tipo/red_de_talleres/$ /index.php?module=talleres&seccion=listado_talleres&tall_tipo=2
RewriteRule ^talleres/tipo/taller_independiente/$ /index.php?module=talleres&seccion=listado_talleres&tall_tipo=1

RewriteRule ^facturacion/([a-zA-Z0-9-._]+)/pagina/([0-9]+)/$ /index.php?module=facturacion&seccion=$1&pagina=$2
RewriteRule ^facturacion/editar_factura/([0-9]+)/$ /index.php?module=facturacion&seccion=editar_factura&idfactura=$1
RewriteRule ^facturacion/emitir_factura/([0-9]+)/$ /index.php?module=facturacion&seccion=emitir_factura&idtaller=$1

RewriteRule ^promociones/([a-zA-Z0-9-._]+)/$ /index.php?module=promociones&seccion=$1
RewriteRule ^promociones/listado_promociones/pagina/([0-9]+)/$ /index.php?module=promociones&seccion=listado_promociones&pagina=$1
RewriteRule ^promociones/editar_promocion/([0-9]+)/$ /index.php?module=promociones&seccion=editar_promocion&idpromocion=$1

